{
  "sourceLanguage" : "en",
  "strings" : {
    "hud.backspace.accessibilityLabel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sil"
          }
        }
      }
    },
    "hud.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return, Tab or arrows to type · Esc to close"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmak için Return, Tab veya oklar · Kapatmak için Esc"
          }
        }
      }
    },
    "hud.permissionMissing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad needs Accessibility access to type"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad'in yazabilmesi için Erişilebilirlik izni gerekiyor"
          }
        }
      }
    },
    "hud.target.accessibilityLabel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typing into %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasına yazılıyor"
          }
        }
      }
    },
    "notice.secureInput" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad can't type while secure input is on, for example in a password field"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli giriş açıkken Keypad yazamaz, örneğin bir şifre alanında"
          }
        }
      }
    },
    "settings.placeholder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings will appear here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar burada görünecek."
          }
