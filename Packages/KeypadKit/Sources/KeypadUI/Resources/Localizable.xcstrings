      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Keypad is disabled, its shortcut does nothing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad devre dışıyken kısayolu hiçbir şey yapmaz."
