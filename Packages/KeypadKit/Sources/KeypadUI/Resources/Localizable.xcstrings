    "hud.backspace.accessibilityLabel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sil"
          }
        }
      }
    },
    "hud.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return, Tab or arrows to type · Esc to close"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmak için Return, Tab veya oklar · Kapatmak için Esc"
          }
        }
      }
    },
    "hud.permissionMissing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad needs Accessibility access to type"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad'in yazabilmesi için Erişilebilirlik izni gerekiyor"
          }
        }
      }
    },
    "hud.target.accessibilityLabel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typing into %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasına yazılıyor"
          }
        }
      }
    },
    "notice.secureInput" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad can't type while secure input is on, for example in a password field"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli giriş açıkken Keypad yazamaz, örneğin bir şifre alanında"
          }
        }
      }
    },
    "settings.activeArea" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active area"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin alan"
          }
        }
      }
    },
    "settings.activeArea.accessibilityValue" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Width %1$lld%%, height %2$lld%%, %3$lld%% from the left, %4$lld%% from the bottom"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genişlik %%%1$lld, yükseklik %%%2$lld, soldan %%%3$lld, alttan %%%4$lld"
          }
        }
      }
    },
    "settings.activeArea.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the area or its corners. Touch the trackpad to see where your fingers land."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alanı veya köşelerini sürükleyin. Parmaklarınızın nereye denk geldiğini görmek için trackpad'e dokunun."
          }
        }
      }
    },
    "settings.activeArea.reset" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Whole Trackpad"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm Trackpad'i Kullan"
          }
        }
      }
    },
    "settings.enabled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
